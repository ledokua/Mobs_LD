{
  "schemaVersion": 1,
  "id": "mobs_ld",
  "version": "${version}",
  "name": "Mobs_LD",
  "description": "Data-driven mobs and bosses: JSON ability timelines with telegraphs, phases and boss rules, a threat system, and reworks of vanilla mobs (Wither, Warden).",
  "authors": [
    "LeDok"
  ],
  "contact": {
    "sources": "https://github.com/ledokua/Mobs_LD",
    "issues": "https://github.com/ledokua/Mobs_LD/issues"
  },
  "license": "MIT",
  "icon": "assets/mobs_ld/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "net.ledok.mobs_ld.client.MobsLdModClient"
    ],
    "main": [
      "net.ledok.mobs_ld.MobsLdMod"
    ]
  },
  "mixins": [
    "mobs_ld.mixins.json"
  ],
  "accessWidener": "mobs_ld.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "geckolib": ">=4.9.0",
    "minecraft": "${minecraft_version}"
  }
}
